---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/data';
const a = site.about;
---
<Base title="About PDH" description={`${a.intro} Founded ${site.founded}; member of ${site.network.name} since ${site.network.memberSince}.`}>
  <PageHero eyebrow="About us" title={site.name} lead={a.intro} />

  <section class="section">
    <div class="container about-grid">
      <div>
        <p>{a.history}</p>
        <p>As member of the MPH network, PDH shares the same goal in providing medical excellence and compassionate care to all our patients.</p>
        <p>{a.facilitiesLine}</p>
        <p>More than just a healthcare provider, PDH is a steadfast partner in the community’s journey to wellness.</p>
        <div class="stats" style="margin-top:24px;text-align:left">
          {site.stats.map((s) => <div><span class="num" style="color:var(--primary)">{s.value}</span><span class="lbl muted">{s.label}</span></div>)}
        </div>
      </div>
      <img src={site.photos.lobby.src} alt={site.photos.lobby.alt} width={site.photos.lobby.w} height={site.photos.lobby.h} loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:var(--radius)" />
    </div>
  </section>

  <section class="section section-soft">
    <div class="container grid grid-3">
      <div class="card"><h2 style="font-size:1.2rem">Our Mission</h2><p style="margin:0">{a.mission}</p></div>
      <div class="card"><h2 style="font-size:1.2rem">Our Vision</h2><p style="margin:0">{a.vision}</p></div>
      <div class="card"><h2 style="font-size:1.2rem">Our Goal</h2><p style="margin:0">{a.goal}</p></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Core values</h2>
      <div class="grid grid-3">
        {a.values.map((v) => <div class="card"><span class="icon-circle"><Icon name="check" /></span><h3 style="font-size:1.1rem">{v.title}</h3><p class="muted" style="margin:0">{v.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <span class="eyebrow">Our leadership team</span>
      <h2>Guided by purpose. Driven by passion.</h2>
      <p class="lead">At PDH, our leadership team is the heart of our progress. With diverse backgrounds and a shared commitment to excellence, they bring together experience, innovation, and compassion to lead our hospital toward a future of patient-centered care and continuous growth.</p>
      <div class="grid grid-4">
        {a.leadership.map((l) => <div class="card"><h3 style="font-size:1rem">{l.name}</h3><p class="meta">{l.role}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Our barangay partners</span>
      <h2>Building healthier communities, together.</h2>
      <p class="lead">At PDH, we believe that meaningful healthcare starts at the grassroots. Through our strong collaborations with barangay leaders and local communities, we bring essential health education, medical services, and support closer to the people.</p>
      <div class="grid grid-4">
        {a.barangayPartners.map((b) => <div class="card"><h3 style="font-size:1.05rem">{b.name}</h3><p class="small muted" style="margin:0">{b.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section section-strong">
    <div class="container">
      <span class="eyebrow">Our network of care</span>
      <h2>{site.network.name}</h2>
      <p class="lead" style="color:inherit">{site.network.blurb}</p>
      <p>{site.network.detail}</p>
      <img src={site.network.mapImage} alt="Map of Metro Pacific Health hospitals across the Philippines" loading="lazy" decoding="async" width="1800" height="600" style="width:100%;height:auto;border-radius:12px;background:#fff" />
    </div>
  </section>

  <style>
    .about-grid { display: grid; gap: 24px; }
    @media (min-width: 900px) { .about-grid { grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: start; } }
  </style>
</Base>
