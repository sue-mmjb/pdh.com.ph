---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/data';
const a = site.about;
// Partners with a PDH photo first, so the photo cards line up
const partners = [...a.barangayPartners].sort((x, y) => Number(!!y.photo) - Number(!!x.photo));
---
<Base title="About PDH" description={`${a.intro} Founded ${site.founded}; member of ${site.network.name} since ${site.network.memberSince}.`}>
  <PageHero photo="/photos/pdh-lobby.webp" photoAlt="The PDH lobby" photoPos="center 50%" eyebrow="About us" title={site.name} lead={a.intro} />

  <section class="section">
    <div class="container about-grid">
      <div>
        <p>{a.history}</p>
        <p>{a.networkLine}</p>
        <p>{a.facilitiesLine}</p>
        <p>{a.closing}</p>
        <div class="stats" style="margin-top:24px;text-align:left">
          {site.stats.map((s) => <div><span class="num" style="color:var(--primary)">{s.value}</span><span class="lbl muted">{s.label}</span></div>)}
        </div>
      </div>
      <img src={site.photos.lobby.src} alt={site.photos.lobby.alt} width={site.photos.lobby.w} height={site.photos.lobby.h} loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:var(--radius)" />
    </div>
  </section>

  <section class="section section-soft">
    <div class="container grid grid-3">
      <div class="card"><h2 style="font-size:1.2rem">Our Mission</h2><p style="margin:0">{a.mission}</p></div>
      <div class="card"><h2 style="font-size:1.2rem">Our Vision</h2><p style="margin:0">{a.vision}</p></div>
      <div class="card"><h2 style="font-size:1.2rem">Our Goal</h2><p style="margin:0">{a.goal}</p></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Core values</h2>
      <div class="about-values">
        {a.values.map((v) => (
          <div class="card about-pcard">
            <img class="about-pcard_img" src={v.photo} alt={v.photoAlt} width="160" height="132" loading="lazy" decoding="async" />
            <h3>{v.title}</h3>
            <p class="muted small">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <span class="eyebrow">Our leadership team</span>
      <h2>{a.leadershipHeading}</h2>
      <p class="lead">{a.leadershipIntro}</p>
      <div class="grid grid-4">
        {a.leadership.map((l) => <div class="card"><h3 style="font-size:1rem">{l.name}</h3><p class="meta">{l.role}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Our barangay partners</span>
      <h2>{a.barangayHeading}</h2>
      <p class="lead">{a.barangayIntro}</p>
      <div class="grid grid-3">
        {partners.map((b) => (
          <div class="card about-pcard">
            {b.photo && <img class="about-pcard_img about-pcard_img--wide" src={b.photo} alt={b.photoAlt} width="395" height="263" loading="lazy" decoding="async" />}
            <h3>{b.name}</h3>
            <p class="small muted">{b.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-strong">
    <div class="container">
      <span class="eyebrow">Our network of care</span>
      <h2>{site.network.name}</h2>
      <p class="lead" style="color:inherit">{site.network.blurb}</p>
      <p>{site.network.detail}</p>
      <img src={site.network.mapImage} alt="Map of Metro Pacific Health hospitals across the Philippines" loading="lazy" decoding="async" width="847" height="298" style="width:100%;max-width:847px;height:auto;border-radius:12px;background:#fff;padding:12px" />
    </div>
  </section>

  <style>
    .about-values { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media (min-width: 900px) { .about-values { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; } }
    .about-pcard { overflow: hidden; padding: 0 16px 18px; }
    .about-pcard_img { display: block; width: calc(100% + 32px); max-width: none; margin: 0 -16px; aspect-ratio: 160 / 132; object-fit: cover; }
    .about-pcard_img--wide { aspect-ratio: 3 / 2; object-position: center 30%; }
    .about-pcard h3 { font-size: 1.05rem; margin: 14px 0 6px; }
    .about-pcard:not(:has(img)) h3 { margin-top: 18px; }
    .about-pcard p { margin: 0; }
    .about-grid { display: grid; gap: 24px; }
    @media (min-width: 900px) { .about-grid { grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: start; } }
  </style>
</Base>
