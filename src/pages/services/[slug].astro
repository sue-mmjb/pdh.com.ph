---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import ToConfirm from '../../components/ToConfirm.astro';
import Sample from '../../components/Sample.astro';
import Placeholder from '../../components/Placeholder.astro';
import Icon from '../../components/Icon.astro';
import { services, doctorsForService, hmo, site, serviceScheduleRows } from '../../lib/data';
import ScheduleTable from '../../components/ScheduleTable.astro';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props;
const docs = doctorsForService(s);
const er = site.phones.emergency;
const isER = s.slug === 'emergency-room';
---
<Base title={s.name} description={`${s.name} at ${site.name}: ${s.summary} ${s.location ? `Location: ${s.location}.` : ''} ${s.hours ? `Hours: ${s.hours}.` : ''}`}>
  <PageHero eyebrow="Our services" title={s.name} lead={s.summary} crumbs={[{ href: '/services/', label: 'Services' }]} />

  <section class="section">
    <div class="container svc-grid">
      <div>
        {s.detail && <p class="lead">{s.detail}</p>}

        <h2 style="font-size:1.3rem">Location and hours</h2>
        <dl class="dl" style="margin-bottom:24px">
          <dt>Floor</dt><dd>{s.location ?? <>Call for location <ToConfirm note="The current site shows TBD for this service's location" /></>}</dd>
          <dt>Hours</dt><dd><ScheduleTable rows={serviceScheduleRows(s.hours)} compact />{s.hoursAlt && <> <ToConfirm note={s.hoursAlt} /></>}</dd>
          <dt>Contact</dt><dd><a href={`tel:${site.phones.trunk.tel}`}>{site.phones.trunk.display}</a>{s.contactLocal && <> · appointments: {site.phones.information.display.replace('local 7000', s.contactLocal)}</>}</dd>
          {s.priceLine && <><dt>Price</dt><dd>{s.priceLine}</dd></>}
        </dl>
        {s.hoursAlt && <p class="note-box small" style="margin:-12px 0 24px">{s.hoursAlt}</p>}

        {s.gallery && (
          <>
            <h2 style="font-size:1.3rem">From PDH</h2>
            <div class="grid grid-2" style="margin-bottom:24px">{s.gallery.map((g) => <img src={g} alt="PDH rehabilitation services slide" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:var(--radius-sm);border:1px solid var(--line)" />)}</div>
          </>
        )}
        {s.programs && (
          <>
            <h2 style="font-size:1.3rem">Programs</h2>
            <div class="grid grid-2" style="margin-bottom:24px">
              {s.programs.map((p) => (
                <div class="card">
                  <h3 style="font-size:1.05rem">{p.name}</h3>
                  <p class="small">{p.summary}</p>
                  {p.conditions.length > 0 && <><p class="small muted" style="margin:0 0 6px"><strong>{p.name === 'Cardiovascular Rehabilitation' ? 'Recommended for patients with' : 'Commonly treated conditions'}</strong></p>
                  <ul class="chips">{p.conditions.map((c) => <li>{c}</li>)}</ul></>}
                </div>
              ))}
            </div>
          </>
        )}

        {s.offered.length > 0 && (
          <>
            <h2 style="font-size:1.3rem">Services offered</h2>
            <ul style="margin-bottom:24px">{s.offered.map((o) => <li>{o}</li>)}</ul>
          </>
        )}

        <h2 style="font-size:1.3rem">HMOs accepted</h2>
        <p>PDH is accredited by PhilHealth and the HMOs listed on the <a href="/hmo-philhealth/">HMO &amp; PhilHealth page</a>. Coverage for a specific service and doctor depends on your plan; the HMO Hub ({hmo.hub.location}, {hmo.hub.hours}) confirms it. <ToConfirm note="Per-service HMO coverage is not on the current site" /></p>

        <h2 style="font-size:1.3rem">How to prepare <Sample /></h2>
        {s.preparation
          ? <p>{s.preparation}</p>
          : <p class="muted">No preparation needed from your side. Bring a valid ID and any PhilHealth or HMO documents.</p>}
        <p class="proto-note">Preparation notes are prototype samples to be replaced by PDH’s own instructions.</p>

        {isER && (
          <div class="kriss-er" style="margin-top:24px">
            <strong>In an emergency, call first or come straight in.</strong>
            <p><a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /> · Mobile <a href={`tel:${er.mobileTel}`}>{er.mobile}</a></p>
            <p class="small" style="margin:0">Ground Floor, {site.address.full}. <a href="/contact/#directions">Directions and parking</a>.</p>
          </div>
        )}
      </div>

      <aside>
        {s.image ? <img src={s.image} alt={`${s.name} at PDH`} loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:var(--radius)" /> : <Placeholder label={`${s.name} at PDH`} ratio="4x3" />}
        <div class="card" style="margin-top:16px">
          <h3 style="font-size:1.05rem">Next step</h3>
          {isER
            ? <a class="btn btn-emergency" href={`tel:${er.tel}`} style="width:100%"><Icon name="emergency" /> Call the ER</a>
            : <a class="btn btn-primary" href={`/book/?service=${s.slug}`} style="width:100%"><Icon name="calendar" /> Request an appointment</a>}
          <a class="btn btn-outline" href={`tel:${site.phones.information.tel}`} style="width:100%;margin-top:8px"><Icon name="phone" /> Call {site.phones.information.display}</a>
          {s.extraLink && <a class="btn btn-ghost" href={s.extraLink.href} target="_blank" rel="noopener" style="width:100%;margin-top:8px">{s.extraLink.label} <Icon name="external" /></a>}
        </div>
      </aside>
    </div>
  </section>

  {docs.length > 0 && (
    <section class="section section-soft">
      <div class="container">
        <h2>Doctors for this service</h2>
        <p class="muted">From PDH’s doctor listing, matched by department or specialization. Schedules are the clinic hours published on the current site.</p>
        <div class="grid grid-3">{docs.slice(0, 12).map((d) => <DoctorCard doctor={d} />)}</div>
        {docs.length > 12 && <p style="margin-top:16px"><a class="btn btn-outline" href={`/doctors/?dept=${encodeURIComponent(s.doctorMatch.departments[0] ?? '')}&q=${encodeURIComponent(s.doctorMatch.specializations[0] ?? '')}`}>See all {docs.length} doctors</a></p>}
      </div>
    </section>
  )}

  <style>
    .svc-grid { display: grid; gap: 32px; }
    @media (min-width: 900px) { .svc-grid { grid-template-columns: 1.6fr 1fr; align-items: start; } aside { position: sticky; top: calc(var(--optionbar-h) + var(--header-h) + 16px); } }
  </style>
</Base>
