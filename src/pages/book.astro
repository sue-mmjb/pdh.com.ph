---
// How to book: PDH's own contact channels. The appointment request form was removed on
// 25 Nov 2026 after PDH's feedback; it can return once its scope and handling process are agreed.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ToConfirm from '../components/ToConfirm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/data';
const er = site.phones.emergency;
---
<Base title="Book an appointment" description={`How to book at ${site.name}: call Information, message PDH on Facebook or email, with your doctor or service in mind. For emergencies call the ER.`}>
  <PageHero eyebrow="Book" title="Book an appointment" lead="Use PDH's own channels to book. Have your doctor or service in mind; every doctor's clinic days and room are on their profile." />

  <section class="section">
    <div class="container book-grid">
      <div>
        <div class="kriss-er">
          <strong>Emergency? Don't book, come in or call.</strong>
          <p style="margin:0">ER: <a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /> · Ground Floor, open 24/7.</p>
        </div>
        <div class="channels">
          <a class="card channel" href={`tel:${site.phones.information.tel}`}>
            <span class="icon-circle"><Icon name="phone" /></span>
            <span><strong>Call Information</strong><br />{site.phones.information.display}<br /><span class="small muted">Mobile {site.phones.information.mobile} · {site.phones.information.mobile2}</span></span>
          </a>
          <a class="card channel" href={site.social.messenger.url} target="_blank" rel="noopener">
            <span class="icon-circle"><Icon name="message" /></span>
            <span><strong>Message PDH on Facebook</strong><br /><span class="small muted">Opens Messenger in a new tab</span></span>
          </a>
          <a class="card channel" href={`mailto:${site.emails.info}`}>
            <span class="icon-circle"><Icon name="mail" /></span>
            <span><strong>Email</strong><br />{site.emails.info}</span>
          </a>
          <a class="card channel" href={`tel:${site.phones.admitting.tel}`}>
            <span class="icon-circle"><Icon name="bed" /></span>
            <span><strong>Admitting</strong><br />{site.phones.admitting.display}<br /><span class="small muted">For admissions and rooms</span></span>
          </a>
        </div>
        <h2 style="font-size:1.15rem;margin-top:28px">Before you call</h2>
        <ul>
          <li>Pick your doctor on <a href="/doctors/">Find a doctor</a>: each profile lists clinic days, room number and accepted HMOs.</li>
          <li>Using an HMO? Request <a href={site.links.hmoOnlineApproval} target="_blank" rel="noopener">online approval</a> or visit the HMO Hub on the Ground Floor before your visit.</li>
          <li>Packages are booked the same way; each package names its own local number on the <a href="/packages/">Packages page</a>.</li>
        </ul>
        <p class="small muted">An online request form is not part of this prototype. It can be added once its scope and PDH's handling process are agreed.</p>
      </div>

      <aside>
        <div class="card">
          <h2 style="font-size:1.1rem">Outpatient clinics</h2>
          <p class="small" style="margin:0">3rd to 6th floors, by appointment. Clinic days vary by doctor.</p>
        </div>
        <div class="card" style="margin-top:16px">
          <h2 style="font-size:1.1rem">Find a doctor</h2>
          <p class="small">Search by name, specialty or concern.</p>
          <a class="btn btn-primary" href="/doctors/" style="width:100%"><Icon name="search" /> Find a doctor</a>
        </div>
      </aside>
    </div>
  </section>

  <style>
    .book-grid { display: grid; gap: 24px; }
    @media (min-width: 900px) { .book-grid { grid-template-columns: 1.6fr 1fr; align-items: start; } }
    .channels { display: grid; gap: 12px; margin-top: 16px; }
    @media (min-width: 640px) { .channels { grid-template-columns: 1fr 1fr; } }
    .channel { display: flex; gap: 14px; align-items: center; text-decoration: none; color: inherit; }
    .channel .icon-circle { margin: 0; flex: none; }
    .channel:hover { border-color: var(--pdh-teal); }
  </style>
</Base>
