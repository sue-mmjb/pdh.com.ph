---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ToConfirm from '../components/ToConfirm.astro';
import Icon from '../components/Icon.astro';
import { site, rooms } from '../lib/data';
const p = site.phones;
const parking = rooms.facilities.find((f) => f.name === 'Parking');
const mapsQuery = encodeURIComponent(`${site.name}, ${site.address.full}`);
const lines = [p.emergency, p.information, p.marketing, p.admitting, p.hmoHub, p.hr];
---
<Base title="Contact and directions" description={`${site.name} address, phone lines, email, directions, parking and visiting hours. ${site.address.full}.`}>
  <PageHero eyebrow="Contact us" title="Contact and directions" lead="Thank you for visiting Parañaque Doctors Hospital. Got questions or concerns? We’re here to help. Just reach out, and we’ll respond as soon as possible." />

  <section class="section">
    <div class="container grid grid-2">
      <div>
        <h2>Phone lines</h2>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th scope="col">Department</th><th scope="col">Landline</th><th scope="col">Mobile</th></tr></thead>
            <tbody>
              {lines.map((l) => (
                <tr>
                  <th scope="row">{l.label}{!l.confirmed && <> <ToConfirm note={l.note} /></>}</th>
                  <td><a href={`tel:${l.tel}`}>{l.display}</a></td>
                  <td>{l.mobile ? <a href={`tel:${l.mobileTel}`}>{l.mobile}</a> : ''}</td>
                </tr>
              ))}
              <tr><th scope="row">Trunk lines</th><td><a href={`tel:${p.trunk.tel}`}>{p.trunk.display}</a></td><td></td></tr>
            </tbody>
          </table>
        </div>
        <h2 style="margin-top:32px">Email</h2>
        <ul>
          <li>General: <a href={`mailto:${site.emails.info}`}>{site.emails.info}</a></li>
          <li>Marketing: <a href={`mailto:${site.emails.marketing}`}>{site.emails.marketing}</a></li>
          <li>Data Protection Officer: <a href={`mailto:${site.emails.dpo}`}>{site.emails.dpo}</a></li>
        </ul>
        <h2 style="margin-top:32px">Social</h2>
        <ul class="pill-list">
          <li><a href={site.social.facebook} target="_blank" rel="noopener">Facebook</a></li>
          <li><a href={site.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={site.social.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href={site.links.feedback} target="_blank" rel="noopener">How was our service?</a></li>
        </ul>
      </div>

      <div id="directions">
        <h2>Directions</h2>
        <address style="font-style:normal;margin-bottom:12px"><strong>{site.name}</strong><br />{site.address.full}</address>
        <div class="ph ph-4x3" role="img" aria-label="Map placeholder: PDH at 175 Doña Soledad Ave., Better Living Subdivision, Parañaque">
          <span>Map placeholder, no third-party map scripts in the prototype</span>
        </div>
        <p style="margin-top:12px"><a class="btn btn-primary" href={`https://www.google.com/maps/search/?api=1&query=${mapsQuery}`} target="_blank" rel="noopener"><Icon name="pin" /> Open in Google Maps</a></p>

        <h3 style="margin-top:24px">Parking</h3>
        <p>{parking?.text}</p>
        <p class="small muted">{parking?.location}. {parking?.hours}.</p>

        <h3>Visiting hours</h3>
        <p>Please call Information for visiting hours. <ToConfirm note={site.visiting.note} /></p>

        <h3>Emergency</h3>
        <p>ER on the Ground Floor, open 24/7. <a href={`tel:${p.emergency.tel}`}>{p.emergency.display}</a> <ToConfirm note={p.emergency.note} /> · Mobile <a href={`tel:${p.emergency.mobileTel}`}>{p.emergency.mobile}</a></p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <h2>Have a question?</h2>
      <p class="lead">One of our Customer Care Representatives will get in touch with you soon to help you with your health concerns and inquiries.</p>
      <a class="btn btn-primary" href="/book/">Send a request</a>
    </div>
  </section>
</Base>
