  "process": {
    "sample": true,
    "steps": [
      {
        "title": "Check your coverage",
        "text": "Confirm with your HMO that PDH and your doctor are accredited for the service you need. Your doctor’s profile lists the HMOs they accept."
      },
      {
        "title": "Go to the HMO Hub",
        "text": "Bring your HMO card, a valid ID, and your doctor’s request. The Hub is on the Ground Floor."
      },
      {
        "title": "Get your approval",
        "text": "The Hub coordinates your Letter of Authorization (LOA). For outpatient services you can also request approval online before you come."
      },
      {
        "title": "Proceed to your service",
        "text": "Present your approval at the clinic, laboratory, or imaging desk. Any amount not covered is settled at the cashier."
      }
    ]
  },
