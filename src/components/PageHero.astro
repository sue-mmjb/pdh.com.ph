---
interface Props { title: string; eyebrow?: string; lead?: string; crumbs?: { href: string; label: string }[]; }
const { title, eyebrow, lead, crumbs = [] } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {crumbs.map((c) => (<> › <a href={c.href}>{c.label}</a></>))}
      </nav>
    )}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    <span class="page-rule" aria-hidden="true"></span>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<script>
  import { heartbeatAll } from '../scripts/heartbeat';
  heartbeatAll('.page-rule');
</script>
<style>
  .page-rule { display: block; height: 34px; width: 128px; max-width: 100%; margin: -6px 0 8px; }
</style>
