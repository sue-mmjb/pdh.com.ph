---
import Icon from './Icon.astro';
import type { Service } from '../lib/data';
interface Props { service: Service; compact?: boolean; }
const { service: s, compact = false } = Astro.props;
---
<a class="card card-link" href={`/services/${s.slug}/`}>
  <span class="icon-circle"><Icon name={s.icon} /></span>
  <h3>{s.name}</h3>
  {!compact && <p class="muted small">{s.summary}</p>}
  <p class="meta">{s.location ? s.location : 'Location to be confirmed'}{s.hours ? ` · ${s.hours.length > 40 ? 'See hours' : s.hours}` : ''}</p>
</a>
