---
// Option C — "Bold Modern": full-bleed charcoal hero with giant type and pill CTAs,
// a floating search card that overlaps the hero, horizontally scrolling service tiles,
// aqua stats block, pillar accordion, chip-style HMO list, compact news tiles.
import { site, hmo, news, featuredServices, specialtyGroups, formatDate } from '../../lib/data';
import Icon from '../Icon.astro';
import ToConfirm from '../ToConfirm.astro';
import Sample from '../Sample.astro';
import Placeholder from '../Placeholder.astro';
const er = site.phones.emergency;
const latest = news.items.slice(0, 3);
---
<section class="hero">
  <div class="container">
    <p class="tag"><span class="dotc"></span> {site.dohLevel} · Parañaque City · Member of {site.network.name}</p>
    <h1>PDH is a<br />pillar of<br /><span class="hl">trust.</span></h1>
    <p class="lead" style="color:inherit;opacity:.9;max-width:60ch">{site.hero.text}</p>
    <div class="actions">
      <a class="btn btn-accent btn-lg" href="/doctors/"><Icon name="search" /> Find a doctor</a>
      <a class="btn btn-lg btn-light" href="/book/"><Icon name="calendar" /> Book</a>
      <a class="btn btn-emergency btn-lg" href={`tel:${er.tel}`}><Icon name="emergency" /> Emergency</a>
    </div>
    <p class="er-line">ER open 24/7 · Ground Floor · <a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /></p>
  </div>
</section>

<section class="floating">
  <div class="container">
    <form class="search-card" action="/doctors/" method="get" role="search">
      <div class="search-in">
        <label class="visually-hidden" for="home-q">Doctor name or specialty</label>
        <Icon name="search" />
        <input id="home-q" name="q" type="search" placeholder="Search 320 doctors by name or specialty" />
      </div>
      <button class="btn btn-primary" type="submit">Search</button>
      <div class="search-chips">
        {specialtyGroups.slice(0, 6).map((g) => <a href={`/doctors/?dept=${encodeURIComponent(g.departments[0])}`}>{g.name}</a>)}
      </div>
    </form>
  </div>
</section>

<section class="section svc">
  <div class="container">
    <div class="row-head">
      <h2>Services</h2>
      <a class="btn btn-outline btn-sm" href="/services/">See all <Icon name="arrow" /></a>
    </div>
  </div>
  <div class="scroller" tabindex="0" aria-label="Featured services, scroll horizontally">
    {featuredServices.map((s) => (
      <a class="tile" href={`/services/${s.slug}/`}>
        <span class="icon-circle"><Icon name={s.icon} /></span>
        <strong>{s.name}</strong>
        <span class="small">{s.location ?? 'Location to confirm'} · {s.hours && s.hours.length > 28 ? 'see hours' : s.hours}</span>
      </a>
    ))}
  </div>
</section>

<section class="stats-c">
  <div class="container stats-grid">
    {site.stats.map((s) => <div><span class="num">{s.value}</span><span class="lbl">{s.label}</span></div>)}
    <div class="stats-copy">
      <h2>Built for Parañaque since 2007.</h2>
      <p>{site.about.intro}</p>
      <a class="btn btn-sm btn-primary" href="/about/">About PDH</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container hmo-c">
    <div>
      <h2>HMO &amp; PhilHealth, sorted at the Hub.</h2>
      <p class="lead">Ground Floor · {hmo.hub.hours}.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/hmo-philhealth/">How approval works</a>
        <a class="btn btn-outline" href={hmo.hub.onlineApproval.url} target="_blank" rel="noopener">Online approval <Icon name="external" /></a>
      </div>
    </div>
    <div>
      <p class="small"><strong>Accepted HMOs</strong> <Sample /> <ToConfirm note="Names taken from logos on the current site; confirm the official list" /></p>
      <ul class="chips">{hmo.partners.map((p) => <li>{p}</li>)}</ul>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container net">
    <Placeholder label="MPH network map or hospital photo" ratio="4x3" />
    <div>
      <span class="eyebrow">Our network of care</span>
      <h2>One of 27 {site.network.name} hospitals.</h2>
      <p>{site.network.detail}</p>
      <ul class="net-figs">
        {site.network.figures.map((f) => <li><strong>{f.value}</strong><span>{f.label}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<section class="section">
  <div class="container pillars-c">
    <div>
      <span class="eyebrow">{site.why.heading}</span>
      <h2>Because, we at PDH…</h2>
      <p class="muted">{site.why.intro}</p>
    </div>
    <div>
      {site.pillars.map((p, i) => (
        <details class="acc" open={i === 0}>
          <summary>{p.title}</summary>
          <div class="body">{p.text}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section section-strong">
  <div class="container">
    <span class="eyebrow">Patient stories</span>
    <h2>Alagang PDH Ako.</h2>
    <div class="grid grid-2 stories">
      {site.stories.map((s) => (
        <article>
          <p class="big">“{s.quote}”</p>
          <p class="small">— {s.by} · <a href={s.url} target="_blank" rel="noopener">{s.title}</a></p>
        </article>
      ))}
    </div>
    <div class="grid grid-3 testi">
      {site.testimonials.slice(0, 3).map((t) => <p class="small">“{t.quote}” — {t.by}</p>)}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="row-head"><h2>PDH News</h2><a class="btn btn-outline btn-sm" href="/news/">All news</a></div>
    <div class="grid grid-3">
      {latest.map((n) => (
        <a class="card card-link" href={n.url} target="_blank" rel="noopener">
          <p class="meta"><time datetime={n.date}>{formatDate(n.date)}</time> · {n.category}</p>
          <h3 style="font-size:1.05rem">{n.title}</h3>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section section-soft contact-c">
  <div class="container">
    <div class="contact-card">
      <div>
        <h2>Visit or call.</h2>
        <p>{site.address.full}</p>
        <p>Emergency <a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /> · Information <a href={`tel:${site.phones.information.tel}`}>{site.phones.information.display}</a> · <a href={`mailto:${site.emails.info}`}>{site.emails.info}</a></p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href="/book/">Send a request</a>
        <a class="btn btn-outline" href="/contact/#directions">Directions</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--bg-strong); color: var(--ink-on-strong); padding: 48px 0 96px; position: relative; overflow: hidden; }
  .hero::after { content: ""; position: absolute; right: -120px; top: -120px; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle, rgba(21,184,166,0.35), transparent 70%); pointer-events: none; }
  @media (min-width: 900px) { .hero { padding: 88px 0 128px; } }
  .hero .tag { font-size: 0.85rem; display: inline-flex; align-items: center; gap: 8px; opacity: 0.85; margin-bottom: 16px; }
  .dotc { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); display: inline-block; }
  .hero h1 { color: inherit; font-size: clamp(2.8rem, 1.4rem + 7vw, 6.5rem); line-height: 0.95; letter-spacing: -0.04em; margin-bottom: 0.4em; }
  .hero .hl { color: var(--accent); }
  .btn-light { background: var(--ink-on-strong); color: var(--ink); }
  .btn-light:hover { background: #fff; color: var(--ink); }
  .er-line { margin-top: 20px; font-size: 0.92rem; opacity: 0.9; }
  .er-line a { color: inherit; }
  .floating { margin-top: -56px; position: relative; z-index: 2; }
  .search-card { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 16px; display: grid; gap: 12px; }
  @media (min-width: 720px) { .search-card { grid-template-columns: 1fr auto; align-items: center; padding: 20px; } .search-chips { grid-column: 1 / -1; } }
  .search-in { display: flex; align-items: center; gap: 10px; border: 2px solid var(--line); border-radius: var(--radius-pill); padding: 0 16px; min-height: 52px; }
  .search-in:focus-within { border-color: var(--primary); }
  .search-in svg { width: 20px; height: 20px; color: var(--ink-soft); flex: none; }
  .search-in input { border: none; background: transparent; font: inherit; width: 100%; min-height: 48px; outline: none; }
  .search-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .search-chips a { display: inline-flex; align-items: center; min-height: 36px; padding: 4px 12px; border-radius: var(--radius-pill); background: var(--accent-soft); color: var(--accent-text); text-decoration: none; font-weight: 600; font-size: 0.88rem; }
  .row-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .row-head h2 { margin: 0; }
  .scroller { display: flex; gap: 12px; overflow-x: auto; padding: 4px var(--gutter) 16px; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; }
  @media (min-width: 1232px) { .scroller { padding-left: calc((100vw - var(--max)) / 2 + var(--gutter)); } }
  .tile { flex: 0 0 230px; scroll-snap-align: start; display: grid; gap: 6px; align-content: start; padding: 18px; background: var(--card); border-radius: var(--radius); border: 1px solid var(--line); text-decoration: none; color: var(--ink); min-height: 150px; }
  .tile:hover { border-color: var(--accent); }
  .tile strong { font-family: var(--font-head); font-size: 1.05rem; line-height: 1.2; }
  .tile .small { color: var(--ink-soft); }
  .stats-c { background: var(--accent); color: #0b1a17; padding: 48px 0; }
  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center; }
  @media (min-width: 900px) { .stats-grid { grid-template-columns: repeat(3, auto) 1.4fr; gap: 40px; } }
  .stats-grid .num { font-family: var(--font-head); font-weight: 900; font-size: clamp(3rem, 2rem + 4vw, 5.5rem); line-height: 1; display: block; letter-spacing: -0.04em; }
  .stats-grid .lbl { font-weight: 700; }
  .stats-copy { grid-column: 1 / -1; }
  @media (min-width: 900px) { .stats-copy { grid-column: auto; } }
  .stats-copy h2, .stats-copy p { color: inherit; }
  .stats-copy .btn-primary { background: #0b1a17; color: #fff; }
  .hmo-c, .pillars-c, .net { display: grid; gap: 24px; }
  @media (min-width: 900px) { .hmo-c, .pillars-c { grid-template-columns: 1fr 1.3fr; gap: 56px; } .net { grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: center; } }
  .net-figs { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .net-figs li { display: grid; }
  .net-figs strong { font-family: var(--font-head); font-size: 2rem; line-height: 1; }
  .net-figs span { font-size: 0.85rem; color: var(--ink-soft); }
  .stories .big { font-family: var(--font-head); font-size: clamp(1.2rem, 1rem + 1vw, 1.6rem); line-height: 1.3; }
  .testi { margin-top: 24px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.18); }
  .contact-card { background: var(--card); border-radius: var(--radius); padding: 24px; display: grid; gap: 16px; box-shadow: var(--shadow); }
  @media (min-width: 900px) { .contact-card { grid-template-columns: 1fr auto; align-items: center; padding: 32px; } }
  .contact-card h2 { margin-bottom: 8px; }
  .contact-card p { margin: 0 0 6px; }
</style>
