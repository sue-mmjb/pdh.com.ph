---
// Option A — "Trust Blue": classic hospital layout. Split hero, quick-action cards,
// service grid, doctor search band, navy stats band, pillar cards.
import { site, hmo, news, featuredServices, specialtyGroups, formatDate } from '../../lib/data';
import Icon from '../Icon.astro';
import ToConfirm from '../ToConfirm.astro';
import Sample from '../Sample.astro';
import Placeholder from '../Placeholder.astro';
import ServiceCard from '../ServiceCard.astro';
const er = site.phones.emergency;
const latest = news.items.slice(0, 4);
---
<section class="hero">
  <div class="container hero-grid">
    <div>
      <span class="eyebrow">{site.dohLevel} hospital · Parañaque City</span>
      <h1>Expert care that feels like home.</h1>
      <p class="lead">{site.why.intro}</p>
      <div class="actions">
        <a class="btn btn-primary btn-lg" href="/doctors/"><Icon name="search" /> Find a doctor</a>
        <a class="btn btn-outline btn-lg" href="/book/"><Icon name="calendar" /> Book an appointment</a>
        <a class="btn btn-emergency btn-lg" href={`tel:${er.tel}`}><Icon name="emergency" /> Emergency</a>
      </div>
      <p class="small muted hero-er">ER open 24/7, Ground Floor · {er.display} <ToConfirm note={er.note} /></p>
    </div>
    <Placeholder label="PDH building façade or lobby" ratio="4x3" />
  </div>
</section>

<section class="quick">
  <div class="container">
    <ul class="quick-grid">
      <li><a href="/doctors/"><Icon name="stethoscope" /><strong>Find a doctor</strong><span>320 doctors, by specialty</span></a></li>
      <li><a href="/hmo-philhealth/"><Icon name="card" /><strong>HMO &amp; PhilHealth</strong><span>HMO Hub, Ground Floor</span></a></li>
      <li><a href="/services/laboratory/"><Icon name="lab" /><strong>Lab &amp; imaging</strong><span>Open 24/7</span></a></li>
      <li><a href={site.links.labResults} target="_blank" rel="noopener"><Icon name="external" /><strong>Online lab results</strong><span>lis.pdh.com.ph</span></a></li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Our services</span>
      <h2>From the ER to specialty clinics, under one roof.</h2>
      <p class="lead">Emergency, outpatient, inpatient and urgent care, with 24/7 laboratory, radiology and pharmacy.</p>
    </div>
    <div class="grid grid-3">
      {featuredServices.slice(0, 9).map((s) => <ServiceCard service={s} />)}
    </div>
    <p style="margin-top:24px"><a class="btn btn-outline" href="/services/">All services and departments <Icon name="arrow" /></a></p>
  </div>
</section>

<section class="section section-soft" id="find-a-doctor">
  <div class="container search-grid">
    <div>
      <span class="eyebrow">Find a doctor</span>
      <h2>Search by name or specialty.</h2>
      <p class="muted">Clinic schedules and room numbers come from PDH’s own doctor listing.</p>
      <form class="search-form" action="/doctors/" method="get" role="search">
        <label class="visually-hidden" for="home-q">Doctor name or specialty</label>
        <input id="home-q" name="q" type="search" placeholder="e.g. cardiology, pediatrics, Dela Cruz" />
        <button class="btn btn-primary" type="submit"><Icon name="search" /> Search</button>
      </form>
    </div>
    <ul class="pill-list">
      {specialtyGroups.map((g) => <li><a href={`/doctors/?dept=${encodeURIComponent(g.departments[0])}`}>{g.name}</a></li>)}
    </ul>
  </div>
</section>

<section class="section section-strong">
  <div class="container">
    <div class="stats">
      {site.stats.map((s) => <div><span class="num">{s.value}</span><span class="lbl">{s.label}</span></div>)}
    </div>
  </div>
</section>

<section class="section">
  <div class="container hmo-grid">
    <div>
      <span class="eyebrow">HMO &amp; PhilHealth</span>
      <h2>Bring your card. We handle the approval.</h2>
      <p>The HMO Hub on the Ground Floor is open {hmo.hub.hours}. PDH is accredited by PhilHealth and the HMOs below.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/hmo-philhealth/">How HMO approval works</a>
        <a class="btn btn-outline" href={hmo.hub.onlineApproval.url} target="_blank" rel="noopener">HMO online approval <Icon name="external" /></a>
      </div>
    </div>
    <div class="card">
      <h3 style="font-size:1rem">Accepted HMOs <Sample /> <ToConfirm note="Names taken from logos on the current site; confirm the official list" /></h3>
      <ul class="cols-3 small">
        {hmo.partners.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container network-grid">
    <div class="icon-circle" style="width:64px;height:64px"><Icon name="network" /></div>
    <div>
      <span class="eyebrow">Our network of care</span>
      <h2>Part of {site.network.name}.</h2>
      <p>{site.network.blurb}</p>
      <p class="muted">{site.network.detail}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{site.why.heading}</span>
      <h2>Because, we at PDH…</h2>
      <p class="lead">{site.why.detail}</p>
    </div>
    <div class="grid grid-3">
      {site.pillars.map((p) => (
        <div class="card">
          <span class="icon-circle"><Icon name="check" /></span>
          <h3>{p.title}</h3>
          <p class="muted" style="margin:0">{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Patient stories</span>
      <h2>Alagang PDH Ako.</h2>
      <p class="lead">Our patients’ stories reflect the heart of what we do at PDH—delivering compassionate care, expert treatment, and a healing experience that truly makes a difference.</p>
    </div>
    <div class="grid grid-2">
      {site.stories.map((s) => (
        <article class="card">
          <blockquote class="quote">“{s.quote}”<footer>— {s.by}</footer></blockquote>
          <h3 style="margin-top:16px;font-size:1.1rem">{s.title}</h3>
          <p class="muted small">{s.excerpt}</p>
          <a href={s.url} target="_blank" rel="noopener">Read the full story on pdh.com.ph</a>
        </article>
      ))}
    </div>
    <div class="grid grid-3" style="margin-top:24px">
      {site.testimonials.slice(0, 3).map((t) => (
        <blockquote class="quote small">“{t.quote}”<footer>— {t.by}</footer></blockquote>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head" style="display:flex;justify-content:space-between;align-items:end;gap:16px;flex-wrap:wrap;max-width:none">
      <div><span class="eyebrow">PDH News</span><h2 style="margin:0">Latest from the hospital</h2></div>
      <a class="btn btn-outline btn-sm" href="/news/">Go to PDH News</a>
    </div>
    <div class="grid grid-4">
      {latest.map((n) => (
        <article class="card">
          <p class="meta"><time datetime={n.date}>{formatDate(n.date)}</time></p>
          <h3 style="font-size:1rem"><a href={n.url} target="_blank" rel="noopener" style="text-decoration:none">{n.title}</a></h3>
          <p class="small muted" style="margin:0">{n.excerpt}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section-strong contact-band">
  <div class="container grid grid-3">
    <div>
      <span class="eyebrow">Visit us</span>
      <h2 style="font-size:1.4rem">{site.name}</h2>
      <p>{site.address.full}</p>
      <a class="btn btn-outline btn-sm" href="/contact/#directions"><Icon name="pin" /> Directions &amp; parking</a>
    </div>
    <div>
      <h3 style="font-size:1rem">Call us</h3>
      <p>Emergency: <a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /><br />
      Information: <a href={`tel:${site.phones.information.tel}`}>{site.phones.information.display}</a><br />
      Mobile: <a href={`tel:${site.phones.information.mobileTel}`}>{site.phones.information.mobile}</a></p>
    </div>
    <div>
      <h3 style="font-size:1rem">Have a question?</h3>
      <p>One of our Customer Care Representatives will get in touch with you to help with your health concerns and inquiries.</p>
      <a class="btn btn-accent btn-sm" href="/book/">Send a request</a>
    </div>
  </div>
</section>

<style>
  .hero { padding: 40px 0 32px; background: linear-gradient(180deg, var(--bg-soft), var(--bg)); }
  .hero-grid { display: grid; gap: 24px; align-items: center; }
  .hero h1 { max-width: 14ch; }
  .hero-er { margin-top: 16px; }
  @media (min-width: 900px) { .hero { padding: 72px 0 56px; } .hero-grid { grid-template-columns: 1.1fr 1fr; gap: 48px; } }
  .quick { margin-top: -8px; }
  .quick-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (min-width: 900px) { .quick-grid { grid-template-columns: repeat(4, 1fr); gap: 16px; } }
  .quick-grid a { display: grid; gap: 4px; padding: 16px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--ink); min-height: var(--tap); box-shadow: var(--shadow); }
  .quick-grid a:hover { border-color: var(--accent); }
  .quick-grid svg { width: 24px; height: 24px; color: var(--accent-text); margin-bottom: 4px; }
  .quick-grid span { font-size: 0.85rem; color: var(--ink-soft); }
  .search-grid { display: grid; gap: 24px; }
  @media (min-width: 900px) { .search-grid { grid-template-columns: 1fr 1fr; align-items: center; } }
  .search-form { display: flex; gap: 8px; flex-wrap: wrap; }
  .search-form input { flex: 1 1 220px; min-height: var(--tap); padding: 10px 14px; border: 1px solid var(--line); border-radius: var(--radius-pill); font: inherit; background: var(--card); }
  .hmo-grid, .network-grid { display: grid; gap: 24px; }
  @media (min-width: 900px) { .hmo-grid { grid-template-columns: 1fr 1.2fr; align-items: start; } .network-grid { grid-template-columns: auto 1fr; gap: 32px; align-items: start; } }
  .contact-band .btn-outline { margin-top: 4px; }
</style>
