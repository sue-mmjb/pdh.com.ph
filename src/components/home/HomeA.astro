---
// Option A — "Minimal Editorial". Structure follows the MinimalGoods reference:
// full-bleed hero with a wordmark that shrinks on scroll, giant stacked headline lines that
// slide away, a sticky circle that grows to full screen, a category rule row, a staggered
// grid with parallax tiles and a sticky group title, and the page flipping light ↔ dark as
// you scroll. All motion is scroll-scrubbed with GSAP bundled locally (no CDN) and is
// skipped entirely when the visitor prefers reduced motion.
import { site, hmo, news, services, rooms, specialtyGroups, doctors, formatDate } from '../../lib/data';
import ToConfirm from '../ToConfirm.astro';
import Sample from '../Sample.astro';
import Icon from '../Icon.astro';

const er = site.phones.emergency;
const gridServices = services.filter((s) => ['emergency-room', 'laboratory', 'radiology', 'multi-diagnostic-center', 'hemodialysis-center', 'eye-center'].includes(s.slug));
const gridDoctors = specialtyGroups.slice(0, 6).map((g) => ({ ...g, count: doctors.filter((d) => g.departments.includes(d.department)).length }));
const gridRooms = rooms.rooms.slice(0, 6);
const gridStories = [...site.stories.map((s) => ({ title: s.title, meta: s.series, url: s.url })), ...news.items.slice(1, 5).map((n) => ({ title: n.title, meta: formatDate(n.date), url: n.url }))];
const groups = [
  { key: 'services', title: 'Services', href: '/services/' },
  { key: 'doctors', title: 'Doctors', href: '/doctors/' },
  { key: 'rooms', title: 'Rooms', href: '/rooms-facilities/' },
  { key: 'stories', title: 'Stories', href: '/news/' },
];
---
<div class="mg" data-mg>
  <!-- Hero: full-bleed photo placeholder with the wordmark that shrinks as you scroll -->
  <section class="mg-hero" data-mg-hero>
    <div class="mg-hero_img" role="img" aria-label="Photo placeholder: PDH building at dusk, full width">
      <span class="mg-hero_label">Photo placeholder: PDH façade (supplied by PDH)</span>
    </div>
    <div class="mg-hero_mark" data-mg-mark aria-hidden="true">Parañaque Doctors Hospital</div>
  </section>

  <!-- Thin editorial nav strip under the global header -->
  <div class="mg-strip">
    <div class="container mg-strip_in">
      <span>{site.dohLevel} · Est. 2007 · Member of {site.network.name}</span>
      <span class="mg-strip_er">ER 24/7 · <a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /></span>
    </div>
  </div>

  <!-- Headline lines that slide away + sticky circle that grows -->
  <section class="mg-head">
    <div class="container">
      <h1 class="mg-head_text">
        <span class="mg-head_wrap"><span class="mg-head_move" data-mg-line>Expert</span></span>
        <span class="mg-head_wrap"><span class="mg-head_move is-alt" data-mg-line>care that</span></span>
        <span class="mg-head_wrap"><span class="mg-head_move" data-mg-line>feels like</span></span>
        <span class="mg-head_wrap"><span class="mg-head_move" data-mg-line>home.</span></span>
      </h1>
      <div class="mg-head_actions" data-mg-actions>
        <a class="btn btn-primary btn-lg" href="/doctors/"><Icon name="search" /> Find a doctor</a>
        <a class="btn btn-outline btn-lg" href="/book/"><Icon name="calendar" /> Book</a>
        <a class="btn btn-emergency btn-lg" href={`tel:${er.tel}`}><Icon name="emergency" /> Emergency</a>
      </div>
    </div>
    <div class="mg-circle_wrap" data-mg-circle-wrap>
      <div class="mg-circle">
        <div class="mg-circle_el" data-mg-circle>
          <div class="mg-circle_img" role="img" aria-label="Photo placeholder: nurse with patient at PDH"></div>
          <div class="mg-circle_copy" data-mg-circle-copy>
            <p class="eyebrow">Alagang PDH Ako</p>
            <p class="mg-circle_quote">“{site.stories[0].quote}”</p>
            <p class="small">— {site.stories[0].by}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Category rule row -->
  <nav class="mg-cats" aria-label="Specialties">
    <div class="container">
      <div class="mg-cats_row">
        {specialtyGroups.map((g) => <a href={`/doctors/?dept=${encodeURIComponent(g.departments[0])}`}><span class="mg-cats_border"></span>{g.name}</a>)}
        <a href="/services/"><span class="mg-cats_border"></span>More</a>
      </div>
    </div>
  </nav>

  <!-- Staggered grid with sticky group title -->
  <section class="mg-grid">
    <div class="container mg-grid_in">
      <div class="mg-grid_titles" aria-hidden="true">
        {groups.map((g, i) => <p class="mg-grid_title" data-mg-title={g.key} class:list={{ 'is-active': i === 0 }}>{g.title}</p>)}
      </div>
      <div class="mg-grid_contain">
        <div class="mg-grid_wrapper" data-mg-wrapper="services">
          <h2 class="visually-hidden">Services</h2>
          <ul class="mg-grid_list">
            {gridServices.map((s, i) => (
              <li class="mg-grid_item" data-mg-item>
                <a class="mg-tile" href={`/services/${s.slug}/`}>
                  <span class="mg-tile_n">0{i + 1}</span>
                  <span class="mg-tile_name">{s.name}</span>
                  <span class="mg-tile_meta">{s.location} · {s.hours && s.hours.length > 28 ? 'see hours' : s.hours}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mg-grid_more"><a href="/services/">All services <Icon name="arrow" class="ic" /></a></p>
        </div>
        <div class="mg-grid_wrapper" data-mg-wrapper="doctors">
          <h2 class="visually-hidden">Doctors</h2>
          <ul class="mg-grid_list">
            {gridDoctors.map((g) => (
              <li class="mg-grid_item" data-mg-item>
                <a class="mg-tile" href={`/doctors/?dept=${encodeURIComponent(g.departments[0])}`}>
                  <span class="mg-tile_n">{g.count}</span>
                  <span class="mg-tile_name">{g.name}</span>
                  <span class="mg-tile_meta">{g.blurb}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mg-grid_more"><a href="/doctors/">Search all {doctors.length} doctors <Icon name="arrow" class="ic" /></a></p>
        </div>
        <div class="mg-grid_wrapper" data-mg-wrapper="rooms">
          <h2 class="visually-hidden">Rooms</h2>
          <ul class="mg-grid_list">
            {gridRooms.map((r, i) => (
              <li class="mg-grid_item" data-mg-item>
                <a class="mg-tile" href="/rooms-facilities/">
                  <span class="mg-tile_n">0{i + 1}</span>
                  <span class="mg-tile_name">{r.name}</span>
                  <span class="mg-tile_meta">{r.capacity}{r.amenities.length ? ` · ${r.amenities.length} amenities` : ''}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mg-grid_more"><a href="/rooms-facilities/">Rooms and facilities <Icon name="arrow" class="ic" /></a></p>
        </div>
        <div class="mg-grid_wrapper" data-mg-wrapper="stories">
          <h2 class="visually-hidden">Stories and news</h2>
          <ul class="mg-grid_list">
            {gridStories.map((s) => (
              <li class="mg-grid_item" data-mg-item>
                <a class="mg-tile" href={s.url} target="_blank" rel="noopener">
                  <span class="mg-tile_n">{s.meta}</span>
                  <span class="mg-tile_name is-sm">{s.title}</span>
                  <span class="mg-tile_meta">Read on pdh.com.ph</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mg-grid_more"><a href="/news/">Go to PDH News <Icon name="arrow" class="ic" /></a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Figures -->
  <section class="mg-figs" data-mg-light>
    <div class="container">
      <div class="mg-figs_row">
        {site.stats.map((s) => <div><span class="mg-figs_num">{s.value}</span><span class="mg-figs_lbl">{s.label}</span></div>)}
        <div><span class="mg-figs_num">24/7</span><span class="mg-figs_lbl">ER · Lab · Radiology · Pharmacy</span></div>
      </div>
    </div>
  </section>

  <!-- Find a doctor -->
  <section class="mg-sec">
    <div class="container mg-two">
      <div>
        <p class="eyebrow">Find a doctor</p>
        <h2>Search by name or specialty.</h2>
      </div>
      <form class="mg-search" action="/doctors/" method="get" role="search">
        <label class="visually-hidden" for="home-q">Doctor name or specialty</label>
        <input id="home-q" name="q" type="search" placeholder="e.g. cardiology, pediatrics, Dela Cruz" />
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
    </div>
  </section>

  <!-- HMO & PhilHealth -->
  <section class="mg-sec">
    <div class="container mg-two">
      <div>
        <p class="eyebrow">HMO &amp; PhilHealth</p>
        <h2>Bring your card. The Hub does the rest.</h2>
        <p class="muted">Ground Floor · {hmo.hub.hours}. PhilHealth-accredited.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/hmo-philhealth/">How it works</a>
          <a class="btn btn-outline" href={hmo.hub.onlineApproval.url} target="_blank" rel="noopener">Online approval</a>
        </div>
      </div>
      <div>
        <p class="small"><strong>Accepted HMOs</strong> <Sample /> <ToConfirm note="Names taken from logos on the current site; confirm the official list" /></p>
        <ul class="cols-3 small">{hmo.partners.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- Network -->
  <section class="mg-sec">
    <div class="container mg-two">
      <div>
        <p class="eyebrow">Our network of care</p>
        <h2>One of 27 {site.network.name} hospitals.</h2>
      </div>
      <div>
        <p class="lead">{site.network.blurb}</p>
        <p class="muted">{site.network.detail}</p>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="mg-sec">
    <div class="container">
      <p class="eyebrow">{site.why.heading}</p>
      <h2 class="mg-pillars_head">Because, we at PDH…</h2>
      <p class="lead">{site.why.intro}</p>
      <dl class="mg-pillars">
        {site.pillars.map((p, i) => <div><dt><span>0{i + 1}</span>{p.title}</dt><dd>{p.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- Testimonials + news list -->
  <section class="mg-sec">
    <div class="container mg-two">
      <div>
        <p class="eyebrow">Patient stories</p>
        {site.testimonials.slice(0, 3).map((t) => <p class="mg-testi">“{t.quote}” <span class="muted">— {t.by}</span></p>)}
      </div>
      <div>
        <p class="eyebrow">PDH News</p>
        <ul class="mg-news">
          {news.items.slice(0, 5).map((n) => <li><time datetime={n.date}>{formatDate(n.date)}</time><a href={n.url} target="_blank" rel="noopener">{n.title}</a></li>)}
        </ul>
        <p><a class="btn btn-outline btn-sm" href="/news/">Go to PDH News</a></p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="mg-sec mg-contact">
    <div class="container mg-two">
      <div>
        <p class="eyebrow">Visit us</p>
        <h2>{site.address.street}</h2>
        <p>{site.address.subdivision}, {site.address.city}, {site.address.postalCode} {site.address.region}</p>
      </div>
      <div>
        <p>Emergency <a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /><br />
        Information <a href={`tel:${site.phones.information.tel}`}>{site.phones.information.display}</a> · <a href={`tel:${site.phones.information.mobileTel}`}>{site.phones.information.mobile}</a><br />
        <a href={`mailto:${site.emails.info}`}>{site.emails.info}</a></p>
        <div class="actions">
          <a class="btn btn-primary" href="/book/">Send a request</a>
          <a class="btn btn-outline" href="/contact/#directions">Directions &amp; parking</a>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.querySelector('[data-mg]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    gsap.registerPlugin(ScrollTrigger);
    const html = document.documentElement;
    const cs = getComputedStyle(html);
    const LIGHT = { '--bg': cs.getPropertyValue('--paper').trim(), '--bg-soft': cs.getPropertyValue('--paper-soft').trim(), '--card': cs.getPropertyValue('--paper').trim(), '--ink': cs.getPropertyValue('--dark').trim(), '--ink-soft': cs.getPropertyValue('--paper-ink-soft').trim(), '--primary': cs.getPropertyValue('--dark').trim(), '--primary-ink': cs.getPropertyValue('--paper').trim(), '--line': 'rgba(46,42,39,0.35)', '--accent-soft': 'rgba(46,42,39,0.08)' };
    const DARK = { '--bg': cs.getPropertyValue('--dark').trim(), '--bg-soft': cs.getPropertyValue('--dark-soft').trim(), '--card': cs.getPropertyValue('--dark').trim(), '--ink': cs.getPropertyValue('--paper').trim(), '--ink-soft': cs.getPropertyValue('--dark-ink-soft').trim(), '--primary': cs.getPropertyValue('--paper').trim(), '--primary-ink': cs.getPropertyValue('--dark').trim(), '--line': 'rgba(232,226,218,0.35)', '--accent-soft': 'rgba(232,226,218,0.1)' };
    // Light ↔ dark page shifts. One writer: each segment only reports where it is in the
    // scroll; the mix (0 = light, 1 = dark) is derived from the segment under the viewport
    // and eased into the CSS variables, so segments never fight over the same properties.
    type Seg = { st: ScrollTrigger; from: number; to: number };
    const segs: Seg[] = [];
    // Background colours cross-fade over the whole segment; text/line colours flip over a
    // narrow band around the midpoint so contrast never collapses to grey-on-grey.
    const BG_KEYS = ['--bg', '--bg-soft', '--card'];
    const pick = (o: Record<string, string>, keys: string[], invert = false) => Object.fromEntries(Object.entries(o).filter(([k]) => keys.includes(k) !== invert));
    const mixBg = gsap.utils.interpolate(pick(LIGHT, BG_KEYS), pick(DARK, BG_KEYS));
    const mixInk = gsap.utils.interpolate(pick(LIGHT, BG_KEYS, true), pick(DARK, BG_KEYS, true));
    const state = { t: 0 };
    const apply = () => {
      const t = state.t;
      const tInk = gsap.utils.clamp(0, 1, (t - 0.48) / 0.04);
      const v = { ...mixBg(t), ...mixInk(tInk) } as Record<string, string>;
      Object.keys(v).forEach((k) => html.style.setProperty(k, v[k]));
    };
    const compute = () => {
      const y = window.scrollY;
      let target = 0;
      for (const s of segs) {
        if (y < s.st.start) break;
        const p = Math.min(1, (y - s.st.start) / Math.max(1, s.st.end - s.st.start));
        target = s.from + (s.to - s.from) * p;
      }
      gsap.to(state, { t: target, duration: 0.8, ease: 'power2.out', overwrite: true, onUpdate: apply });
    };
    const flip = (trigger: Element, from: number, to: number, start = 'top 70%', end = 'top 20%') =>
      segs.push({ st: ScrollTrigger.create({ trigger, start, end }), from, to });
    const L = 0, D = 1;

    // Hero wordmark shrinks and fades as the hero scrolls out
    const hero = root.querySelector('[data-mg-hero]');
    gsap.to('[data-mg-mark]', { scale: 0.35, yPercent: -40, opacity: 0, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 } });

    // Headline lines slide down out of their clipping wrappers
    root.querySelectorAll('[data-mg-line]').forEach((el) => {
      gsap.to(el, { yPercent: 100, ease: 'none', scrollTrigger: { trigger: el, start: 'top 30%', end: 'bottom -10%', scrub: 0.8 } });
    });
    gsap.to('[data-mg-actions]', { opacity: 0, y: 20, ease: 'none', scrollTrigger: { trigger: '[data-mg-actions]', start: 'top 25%', end: 'bottom 5%', scrub: 0.8 } });

    // Sticky circle grows to full screen; its copy fades in
    const wrap = root.querySelector('[data-mg-circle-wrap]');
    gsap.fromTo('[data-mg-circle]', { width: 'min(35em, 80vw)', height: 'min(35em, 80vw)', borderRadius: '50%' }, { width: '100vw', height: '100vh', borderRadius: '0%', ease: 'none', scrollTrigger: { trigger: wrap, start: 'top top', end: 'bottom bottom', scrub: 1 } });
    gsap.fromTo('[data-mg-circle-copy]', { opacity: 0, y: 30 }, { opacity: 1, y: 0, ease: 'none', scrollTrigger: { trigger: wrap, start: '50% bottom', end: 'bottom bottom', scrub: 1 } });
    if (wrap) flip(wrap, L, D, 'top 10%', 'center center');

    // Grid: alternate dark/light per wrapper, parallax tiles, sticky title switching
    const wrappers = Array.from(root.querySelectorAll('[data-mg-wrapper]'));
    const titles = Array.from(root.querySelectorAll('[data-mg-title]'));
    wrappers.forEach((w, i) => {
      flip(w, i % 2 === 0 ? D : L, i % 2 === 0 ? L : D);
      const key = w.getAttribute('data-mg-wrapper') || '';
      const activate = () => {
        titles.forEach((t) => t.classList.toggle('is-active', t.getAttribute('data-mg-title') === key));
        root.setAttribute('data-mg-active', key);
      };
      ScrollTrigger.create({ trigger: w, start: 'top 60%', end: 'bottom 60%', onToggle: (self) => { if (self.isActive) activate(); } });
    });
    root.querySelectorAll('[data-mg-item]').forEach((el, i) => {
      const amount = [-20, -40, -60][i % 3];
      gsap.to(el, { yPercent: amount, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 1 + (i % 3) * 0.5 } });
    });
    // Make sure the rest of the page ends light
    const figs = root.querySelector('[data-mg-light]');
    if (figs) flip(figs, wrappers.length % 2 === 0 ? D : L, L, 'top 80%', 'top 30%');
    // Drive the mix from scroll; recompute after ScrollTrigger refreshes (resize, fonts).
    ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', onUpdate: compute, onRefresh: compute });
    compute();
  }
</script>

<style>
  .mg { --ease: cubic-bezier(.2,.7,.2,1); }
  .mg .ic { width: 16px; height: 16px; display: inline; vertical-align: -3px; }

  /* Hero */
  .mg-hero { position: relative; height: calc(100vh - var(--optionbar-h) - var(--header-h)); min-height: 420px; overflow: hidden; }
  .mg-hero_img { position: absolute; inset: 0; background: repeating-linear-gradient(135deg, var(--paper-soft) 0 18px, #d2c9bd 18px 20px); display: grid; place-items: center; }
  .mg-hero_label { font-size: 0.8rem; background: var(--paper); border: 1px solid var(--dark); padding: 6px 10px; }
  .mg-hero_mark { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 4vw; font-family: var(--font-head); font-weight: 900; text-transform: uppercase; letter-spacing: -0.04em; line-height: 0.9; font-size: clamp(2.2rem, 7.4vw, 8.6rem); color: var(--dark); transform-origin: left bottom; will-change: transform, opacity; }

  /* Strip */
  .mg-strip { border-top: 1px solid currentColor; border-bottom: 1px solid currentColor; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .mg-strip_in { display: flex; justify-content: space-between; gap: 16px; min-height: 40px; align-items: center; flex-wrap: wrap; }
  .mg-strip a { color: inherit; }

  /* Headline + circle */
  .mg-head { position: relative; }
  .mg-head .container { padding-top: 10vh; }
  .mg-head_text { margin: 0; line-height: 0.92; font-size: clamp(3rem, 1.5rem + 11vw, 11rem); letter-spacing: -0.04em; text-transform: uppercase; }
  .mg-head_wrap { display: block; overflow: hidden; }
  .mg-head_move { display: block; will-change: transform; }
  .mg-head_move.is-alt { -webkit-text-stroke: 2px var(--ink); color: transparent; }
  .mg-head_actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .mg-circle_wrap { height: 200vh; position: relative; margin-top: 10vh; }
  .mg-circle { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .mg-circle_el { position: relative; width: min(35em, 80vw); height: min(35em, 80vw); border-radius: 50%; overflow: hidden; background: #9c8f80; display: grid; place-items: center; }
  .mg-circle_img { position: absolute; inset: 0; background: radial-gradient(circle at 30% 30%, #b8ab9b, #6e6257 70%); }
  .mg-circle_copy { position: relative; max-width: 42rem; padding: 24px; color: var(--paper); text-align: center; opacity: 0; }
  .mg-circle_copy .eyebrow { color: inherit; }
  .mg-circle_quote { font-family: var(--font-head); font-size: clamp(1.2rem, 1rem + 1.6vw, 2.2rem); line-height: 1.15; text-transform: none; letter-spacing: -0.01em; margin: 0 0 8px; }

  /* Category rule row */
  .mg-cats { padding: 24px 0 0; }
  .mg-cats_row { display: flex; flex-wrap: wrap; gap: 0 24px; }
  .mg-cats_row a { position: relative; display: inline-flex; align-items: center; min-height: var(--tap); padding: 10px 0; text-decoration: none; color: inherit; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; flex: 1 1 auto; }
  .mg-cats_border { position: absolute; left: 0; right: 0; top: 0; height: 1px; background: currentColor; transform-origin: left; transition: transform 0.3s var(--ease); }
  .mg-cats_row a:hover .mg-cats_border { transform: scaleY(3); }

  /* Grid */
  .mg-grid { padding: 10vh 0 0; }
  .mg-grid_in { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 900px) { .mg-grid_in { grid-template-columns: 1fr 3fr; gap: 48px; } }
  .mg-grid_titles { position: sticky; top: calc(var(--optionbar-h) + var(--header-h)); align-self: start; display: grid; z-index: 2; background: var(--bg); padding: 12px 0; margin: 0 calc(-1 * var(--gutter)); padding-left: var(--gutter); padding-right: var(--gutter); }
  @media (min-width: 900px) { .mg-grid_titles { top: calc(var(--optionbar-h) + var(--header-h) + 16px); background: transparent; padding: 0; margin: 0; } }
  .mg-grid_title { grid-area: 1 / 1; margin: 0; font-family: var(--font-head); font-weight: 900; text-transform: uppercase; letter-spacing: -0.03em; font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem); line-height: 1; opacity: 0; transition: opacity 0.4s var(--ease); pointer-events: none; }
  .mg-grid_title.is-active { opacity: 1; }
  .mg-grid_wrapper { padding: 10vh 0 14vh; }
  .mg-grid_list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; align-items: flex-start; }
  .mg-grid_item { will-change: transform; }
  .mg-grid_item:nth-child(6n+1) { width: 48%; margin-right: 4%; }
  .mg-grid_item:nth-child(6n+2) { width: 48%; margin-top: 18%; }
  .mg-grid_item:nth-child(6n+3) { width: 40%; margin-top: 6%; margin-right: 8%; }
  .mg-grid_item:nth-child(6n+4) { width: 52%; margin-top: 22%; }
  .mg-grid_item:nth-child(6n+5) { width: 56%; margin-right: 6%; margin-top: -8%; }
