---
// Option A — PDH brand on the MinimalGoods motion system, arranged task-first:
//  1 hero with Find a doctor / Book / Emergency in the first screen
//  2 doctor search inline
//  3 services grid (sticky title, parallax tiles)   4 rooms grid
//  5 HMO & PhilHealth                               6 figures + MPH network (trust band)
//  7 Why PDH pillars                                8 patient stories (growing circle)
//  9 news                                          10 contact
// Motion is scroll-scrubbed with GSAP bundled locally (no CDN) and skipped under reduced motion.
import { site, hmo, news, services, rooms, specialtyGroups, doctors, featuredPackages, formatDate } from '../../lib/data';
import ToConfirm from '../ToConfirm.astro';
import Sample from '../Sample.astro';
import Icon from '../Icon.astro';

const er = site.phones.emergency;
const always = services.filter((s) => s.hours === 'Open 24/7' && ['emergency-room', 'laboratory', 'radiology', 'pharmacy'].includes(s.slug));
const clinics = services.filter((s) => ['multi-diagnostic-center', 'hemodialysis-center', 'eye-center', 'dental-services', 'ob-ultrasound', 'nuclear-medicine', 'physical-medicine-rehabilitation', 'pulmonary'].includes(s.slug));
const gridServices = [...always, ...clinics];
const gridRooms = rooms.rooms.slice(0, 6);
const groups = [
  { key: 'services', title: 'Services', href: '/services/' },
  { key: 'rooms', title: 'Rooms', href: '/rooms-facilities/' },
];
---
<div class="mg" data-mg>
  <!-- 1 · Hero: headline + the three actions in the first screen, photo slot behind -->
  <section class="mg-hero" data-mg-hero>
    <div class="mg-hero_img" role="img" aria-label="Photo placeholder: PDH building, full width"></div>
    <div class="container mg-hero_in">
      <p class="mg-kicker"><span class="mg-kicker_dot"></span> {site.dohLevel} hospital · Parañaque City · Member of {site.network.name}</p>
      <h1 class="mg-head_text">
        <span class="mg-head_wrap"><span class="mg-head_move" data-mg-line>PDH is a</span></span>
        <span class="mg-head_wrap"><span class="mg-head_move is-alt" data-mg-line>pillar</span></span>
        <span class="mg-head_wrap"><span class="mg-head_move" data-mg-line>of trust.</span></span>
      </h1>
      <p class="mg-hero_lead">{site.hero.text}</p>
      <div class="mg-head_actions" data-mg-actions>
        <a class="btn btn-primary btn-lg" href="/doctors/"><Icon name="search" /> Find a doctor</a>
        <a class="btn btn-accent btn-lg" href="/book/"><Icon name="calendar" /> Book</a>
        <a class="btn btn-emergency btn-lg" href={`tel:${er.tel}`}><Icon name="emergency" /> Emergency</a>
      </div>
      <p class="mg-hero_er">ER open 24/7 · Ground Floor · <a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /> · Mobile <a href={`tel:${er.mobileTel}`}>{er.mobile}</a></p>
      <span class="mg-hero_label">Photo placeholder: PDH façade (supplied by PDH)</span>
    </div>
  </section>

  <!-- 2 · Doctor search, inline -->
  <section class="mg-search_sec">
    <div class="container">
      <form class="mg-search_card" action="/doctors/" method="get" role="search">
        <div>
          <p class="eyebrow">Find a doctor</p>
          <h2 class="mg-search_h">Search by name or specialty.</h2>
          <p class="small muted" style="margin:4px 0 0">{doctors.length} doctors listed on PDH’s directory; PDH counts 320 on staff.</p>
        </div>
        <div class="mg-search_in">
          <label class="visually-hidden" for="home-q">Doctor name or specialty</label>
          <Icon name="search" />
          <input id="home-q" name="q" type="search" placeholder="e.g. cardiology, pediatrics, Dela Cruz" />
          <button class="btn btn-primary" type="submit">Search</button>
        </div>
        <nav class="mg-cats_row" aria-label="Specialties">
          {specialtyGroups.map((g) => <a href={`/doctors/?dept=${encodeURIComponent(g.departments[0])}`}><span class="mg-cats_border"></span>{g.name}</a>)}
          <a href="/doctors/"><span class="mg-cats_border"></span>All doctors</a>
        </nav>
      </form>
    </div>
  </section>

  <!-- 3 + 4 · Services and rooms: staggered grid with sticky group title -->
  <section class="mg-grid">
    <div class="container mg-grid_in">
      <div class="mg-grid_titles" aria-hidden="true">
        {groups.map((g, i) => <p class="mg-grid_title" data-mg-title={g.key} class:list={{ 'is-active': i === 0 }}>{g.title}</p>)}
      </div>
      <div class="mg-grid_contain">
        <div class="mg-grid_wrapper" data-mg-wrapper="services">
          <h2 class="visually-hidden">Services</h2>
          <p class="mg-grid_lead">Open 24/7: ER, laboratory, radiology and pharmacy. Clinics and centers by schedule. Floors and hours as published by PDH.</p>
          <ul class="mg-grid_list">
            {gridServices.map((s, i) => (
              <li class="mg-grid_item" data-mg-item>
                <a class="mg-tile" href={`/services/${s.slug}/`}>
                  <span class="mg-tile_n">{s.hours === 'Open 24/7' ? '24/7' : `0${i + 1}`.slice(-2)}</span>
                  <span class="mg-tile_name">{s.name}</span>
                  <span class="mg-tile_meta">{s.location} · {s.hours && s.hours.length > 28 ? 'see hours' : s.hours}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mg-grid_more"><a href="/services/">All services and departments <Icon name="arrow" class="ic" /></a></p>
        </div>
        <div class="mg-grid_wrapper" data-mg-wrapper="rooms">
          <h2 class="visually-hidden">Rooms</h2>
          <p class="mg-grid_lead">A 94-bed inpatient facility. Air-conditioned rooms with 24/7 nursing support.</p>
          <ul class="mg-grid_list">
            {gridRooms.map((r, i) => (
              <li class="mg-grid_item" data-mg-item>
                <a class="mg-tile" href="/rooms-facilities/">
                  <span class="mg-tile_n">0{i + 1}</span>
                  <span class="mg-tile_name">{r.name}</span>
                  <span class="mg-tile_meta">{r.capacity}{r.amenities.length ? ` · ${r.amenities.length} amenities` : ''}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mg-grid_more"><a href="/rooms-facilities/">Rooms and facilities <Icon name="arrow" class="ic" /></a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · HMO & PhilHealth -->
  <section class="mg-sec" data-mg-light>
    <div class="container mg-two">
      <div>
        <p class="eyebrow">HMO &amp; PhilHealth</p>
        <h2>Bring your card. The Hub does the rest.</h2>
        <p class="muted">HMO Hub, Ground Floor · {hmo.hub.hours}. PhilHealth-accredited.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/hmo-philhealth/">How it works</a>
          <a class="btn btn-outline" href={hmo.hub.onlineApproval.url} target="_blank" rel="noopener">Online approval</a>
        </div>
      </div>
      <div>
        <p class="small"><strong>Accepted HMOs</strong> <Sample /> <ToConfirm note="Names taken from logos on the current site; confirm the official list" /></p>
        <ul class="cols-3 small">{hmo.partners.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- 5b · Packages and promos (as published by PDH) -->
  <section class="mg-sec">
    <div class="container">
      <div class="mg-two" style="align-items:end;margin-bottom:20px">
        <div><p class="eyebrow">Packages &amp; promos</p><h2>Bundled tests at one price.</h2></div>
        <p class="muted" style="margin:0">Prices as published on pdh.com.ph, November 2026. <a href="/packages/">All packages</a></p>
      </div>
      <div class="grid grid-4">
        {featuredPackages.slice(0, 4).map((p) => (
          <a class="card card-link mg-pkg" href={`/packages/#${p.slug}`}>
            <span class="mg-tile_n">{p.category}</span>
            <h3 style="font-size:1.05rem;margin:6px 0 2px">{p.name}</h3>
            <span class="mg-pkg_price">{p.priceLabel}</span>
            <span class="small muted">{p.tiers ? `${p.tiers.length} options` : p.items ? `${p.items.length} tests priced` : `${p.includes.length} inclusions`}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6 · Trust band: figures + MPH network (static dark) -->
  <section class="mg-trust section-strong">
    <div class="container">
      <div class="mg-figs_row">
        {site.stats.map((s) => <div><span class="mg-figs_num">{s.value}</span><span class="mg-figs_lbl">{s.label}</span></div>)}
        <div><span class="mg-figs_num">24/7</span><span class="mg-figs_lbl">ER · Lab · Radiology · Pharmacy</span></div>
      </div>
      <div class="mg-two mg-trust_net">
        <div>
          <p class="eyebrow">Our network of care</p>
          <h2>One of 27 {site.network.name} hospitals.</h2>
        </div>
        <div>
          <p class="lead" style="color:inherit">{site.network.blurb}</p>
          <p style="opacity:.9">{site.network.detail}</p>
          <p class="small" style="opacity:.8">Founded {site.founded} · {site.dohLevel} · MPH member since {site.network.memberSince} · accredited by DOH, PhilHealth and HMOs</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7 · Why PDH -->
  <section class="mg-sec">
    <div class="container">
      <p class="eyebrow">{site.why.heading}</p>
      <h2 class="mg-pillars_head">Because, we at PDH…</h2>
      <p class="lead">{site.why.intro}</p>
      <dl class="mg-pillars">
        {site.pillars.map((p, i) => <div><dt><span>0{i + 1}</span>{p.title}</dt><dd>{p.text}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- 8 · Patient stories: the growing circle, then testimonials -->
  <section class="mg-stories">
    <div class="container"><p class="eyebrow">Alagang PDH Ako Stories</p></div>
    <div class="mg-circle_wrap" data-mg-circle-wrap>
      <div class="mg-circle">
        <div class="mg-circle_el" data-mg-circle>
          <div class="mg-circle_img" role="img" aria-label="Photo placeholder: nurse with patient at PDH"></div>
          <div class="mg-circle_copy" data-mg-circle-copy>
            <p class="eyebrow">{site.stories[0].series}</p>
            <p class="mg-circle_quote">“{site.stories[0].quote}”</p>
            <p class="small">— {site.stories[0].by}</p>
            <a class="btn btn-sm mg-circle_btn" href={site.stories[0].url} target="_blank" rel="noopener">Read the story</a>
          </div>
        </div>
      </div>
    </div>
    <div class="container mg-two mg-testi_wrap">
      <div>
        <h2>What patients say.</h2>
        <p class="muted">Our patients’ stories reflect the heart of what we do at PDH—delivering compassionate care, expert treatment, and a healing experience that truly makes a difference.</p>
      </div>
      <div>
        {site.testimonials.slice(0, 4).map((t) => <p class="mg-testi">“{t.quote}” <span class="muted">— {t.by}</span></p>)}
        <p class="small"><a href={site.stories[1].url} target="_blank" rel="noopener">{site.stories[1].series}: {site.stories[1].title}</a></p>
      </div>
    </div>
  </section>

  <!-- 9 · News -->
  <section class="mg-sec" data-mg-news>
    <div class="container mg-two">
      <div>
        <p class="eyebrow">PDH News</p>
        <h2>From the community.</h2>
        <p><a class="btn btn-outline btn-sm" href="/news/">Go to PDH News</a></p>
      </div>
      <ul class="mg-news">
        {news.items.slice(0, 5).map((n) => <li><time datetime={n.date}>{formatDate(n.date)}</time><a href={n.url} target="_blank" rel="noopener">{n.title}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- 10 · Contact -->
  <section class="mg-sec mg-contact">
    <div class="container mg-two">
      <div>
        <p class="eyebrow">Visit us</p>
        <h2>{site.address.street}</h2>
        <p>{site.address.subdivision}, {site.address.city}, {site.address.postalCode} {site.address.region}</p>
      </div>
      <div>
        <p>Emergency <a href={`tel:${er.tel}`}>{er.display}</a> <ToConfirm note={er.note} /><br />
        Information <a href={`tel:${site.phones.information.tel}`}>{site.phones.information.display}</a> · <a href={`tel:${site.phones.information.mobileTel}`}>{site.phones.information.mobile}</a><br />
        <a href={`mailto:${site.emails.info}`}>{site.emails.info}</a></p>
        <div class="actions">
          <a class="btn btn-primary" href="/book/">Send a request</a>
          <a class="btn btn-outline" href="/contact/#directions">Directions &amp; parking</a>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const root = document.querySelector('[data-mg]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && !reduce) {
    gsap.registerPlugin(ScrollTrigger);
    const html = document.documentElement;
    const cs = getComputedStyle(html);
    const LIGHT = { '--bg': cs.getPropertyValue('--paper').trim(), '--bg-soft': cs.getPropertyValue('--paper-soft').trim(), '--card': cs.getPropertyValue('--paper').trim(), '--ink': cs.getPropertyValue('--pdh-navy').trim(), '--ink-soft': cs.getPropertyValue('--paper-ink-soft').trim(), '--primary': cs.getPropertyValue('--pdh-teal-text').trim(), '--primary-ink': '#ffffff', '--line': 'rgba(0,124,126,0.3)', '--accent-soft': '#fff1e6', '--heading': cs.getPropertyValue('--pdh-blue-text').trim() };
    const DARK = { '--bg': cs.getPropertyValue('--dark').trim(), '--bg-soft': cs.getPropertyValue('--dark-soft').trim(), '--card': cs.getPropertyValue('--dark').trim(), '--ink': '#ffffff', '--ink-soft': cs.getPropertyValue('--dark-ink-soft').trim(), '--primary': '#ffffff', '--primary-ink': cs.getPropertyValue('--dark').trim(), '--line': 'rgba(255,255,255,0.35)', '--accent-soft': 'rgba(255,255,255,0.12)', '--heading': '#ffffff' };
    // Light ↔ dark page shifts. One writer: each segment only reports where it is in the
    // scroll; the mix (0 = light, 1 = dark) is derived from the segment under the viewport
    // and eased into the CSS variables, so segments never fight over the same properties.
    type Seg = { st: ScrollTrigger; from: number; to: number };
    const segs: Seg[] = [];
    const BG_KEYS = ['--bg', '--bg-soft', '--card'];
    const pick = (o: Record<string, string>, keys: string[], invert = false) => Object.fromEntries(Object.entries(o).filter(([k]) => keys.includes(k) !== invert));
    const mixBg = gsap.utils.interpolate(pick(LIGHT, BG_KEYS), pick(DARK, BG_KEYS));
    const mixInk = gsap.utils.interpolate(pick(LIGHT, BG_KEYS, true), pick(DARK, BG_KEYS, true));
    const headToNavy = gsap.utils.interpolate(LIGHT['--heading'], cs.getPropertyValue('--pdh-navy').trim());
    const state = { t: 0 };
    const apply = () => {
      const t = state.t;
      const tInk = t >= 0.69 ? 1 : 0; // hard step at the point that maximises the contrast floor (≈3.7:1 at worst, 7.8:1 settled)
      const v = { ...mixBg(t), ...mixInk(tInk) } as Record<string, string>;
      // Headings: blue on white can't survive a teal background, so slide blue → navy as the
      // page darkens, then snap to white together with the body text.
      v['--heading'] = gsap.utils.interpolate(headToNavy(gsap.utils.clamp(0, 1, t / 0.4)), '#ffffff')(tInk);
      Object.keys(v).forEach((k) => html.style.setProperty(k, v[k]));
    };
    const compute = () => {
      const y = window.scrollY;
      let target = 0;
      for (const s of segs) {
        if (y < s.st.start) break;
        const p = Math.min(1, (y - s.st.start) / Math.max(1, s.st.end - s.st.start));
        target = s.from + (s.to - s.from) * p;
      }
      gsap.to(state, { t: target, duration: 0.8, ease: 'power2.out', overwrite: true, onUpdate: apply });
    };
    const flip = (trigger: Element, from: number, to: number, start = 'top 70%', end = 'top 20%') =>
      segs.push({ st: ScrollTrigger.create({ trigger, start, end }), from, to });
    const L = 0, D = 1;

    // Hero: headline lines slide down out of their clipping wrappers; actions fade
    root.querySelectorAll('[data-mg-line]').forEach((el) => {
      gsap.to(el, { yPercent: 100, ease: 'none', scrollTrigger: { trigger: el, start: 'top 25%', end: 'bottom -20%', scrub: 0.8 } });
    });
    gsap.to('[data-mg-actions]', { opacity: 0, y: 20, ease: 'none', scrollTrigger: { trigger: '[data-mg-actions]', start: 'top 20%', end: 'bottom -10%', scrub: 0.8 } });

    // Grid: services L→D, rooms D→L; parallax tiles; sticky title switching
    const wrappers = Array.from(root.querySelectorAll('[data-mg-wrapper]'));
    const titles = Array.from(root.querySelectorAll('[data-mg-title]'));
    wrappers.forEach((w, i) => {
      flip(w, i % 2 === 0 ? L : D, i % 2 === 0 ? D : L);
      const key = w.getAttribute('data-mg-wrapper') || '';
      const activate = () => {
        titles.forEach((t) => t.classList.toggle('is-active', t.getAttribute('data-mg-title') === key));
        root.setAttribute('data-mg-active', key);
      };
      ScrollTrigger.create({ trigger: w, start: 'top 60%', end: 'bottom 60%', onToggle: (self) => { if (self.isActive) activate(); } });
    });
    root.querySelectorAll('[data-mg-item]').forEach((el, i) => {
      const amount = [-20, -40, -60][i % 3];
      gsap.to(el, { yPercent: amount, ease: 'none', scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 1 + (i % 3) * 0.5 } });
    });
    // HMO section: make sure the page is light again after the rooms group
    const hmoSec = root.querySelector('[data-mg-light]');
    if (hmoSec) flip(hmoSec, wrappers.length % 2 === 0 ? L : D, L, 'top 80%', 'top 30%');

    // Stories: sticky circle grows to full screen (page darkens with it); copy fades in
    const wrap = root.querySelector('[data-mg-circle-wrap]');
    gsap.fromTo('[data-mg-circle]', { width: 'min(32em, 80vw)', height: 'min(32em, 80vw)', borderRadius: '50%' }, { width: '100vw', height: '100vh', borderRadius: '0%', ease: 'none', scrollTrigger: { trigger: wrap, start: 'top top', end: 'bottom bottom', scrub: 1 } });
    gsap.fromTo('[data-mg-circle-copy]', { opacity: 0, y: 30 }, { opacity: 1, y: 0, ease: 'none', scrollTrigger: { trigger: wrap, start: '40% bottom', end: 'bottom bottom', scrub: 1 } });
    if (wrap) flip(wrap, L, D, 'top 20%', 'center center');
    // News: back to light for the end of the page
    const newsSec = root.querySelector('[data-mg-news]');
    if (newsSec) flip(newsSec, D, L, 'top 80%', 'top 30%');

    ScrollTrigger.create({ trigger: root, start: 'top top', end: 'bottom bottom', onUpdate: compute, onRefresh: compute });
    compute();
  }
</script>

<style>
  .mg { --ease: cubic-bezier(.2,.7,.2,1); }
  .mg .ic { width: 16px; height: 16px; display: inline; vertical-align: -3px; }
  .mg-kicker { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em; display: inline-flex; align-items: center; gap: 8px; margin: 0 0 16px; color: var(--pdh-teal-text); font-weight: 700; }
  .mg-kicker_dot { width: 10px; height: 10px; background: var(--pdh-orange); display: inline-block; }

  /* 1 · Hero */
  .mg-hero { position: relative; min-height: calc(100vh - var(--optionbar-h) - var(--header-h) - var(--bottombar-h)); display: flex; align-items: center; overflow: hidden; }
  @media (min-width: 900px) { .mg-hero { min-height: calc(100vh - var(--optionbar-h) - var(--header-h)); } }
  .mg-hero_img { position: absolute; inset: 0; background: repeating-linear-gradient(135deg, var(--pdh-teal-tint) 0 18px, rgba(0,163,165,0.16) 18px 20px); }
  .mg-hero_img::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(255,255,255,0.92) 0 40%, rgba(255,255,255,0.55) 70%, rgba(255,255,255,0.2)); }
  .mg-hero_in { position: relative; padding-top: 40px; padding-bottom: 56px; }
  .mg-hero_label { position: absolute; right: var(--gutter); bottom: 12px; font-size: 0.72rem; background: #ffffff; border: 1px solid var(--pdh-teal); color: var(--pdh-navy); padding: 4px 8px; }
  .mg-head_text { margin: 0; line-height: 0.92; font-size: clamp(2.8rem, 1.2rem + 8vw, 7.5rem); letter-spacing: -0.04em; text-transform: uppercase; color: var(--heading); }
  .mg-head_wrap { display: block; overflow: hidden; }
  .mg-head_move { display: block; will-change: transform; }
  .mg-head_move.is-alt { -webkit-text-stroke: 2px var(--pdh-teal); color: transparent; }
  .mg-head_actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .mg-hero_er { margin: 16px 0 0; font-size: 0.9rem; color: var(--ink); }
  .mg-hero_lead { max-width: 58ch; margin: 20px 0 0; font-size: 1.05rem; color: var(--ink); }
  @media (min-width: 900px) { .mg-hero_lead { font-size: 1.15rem; } }

  /* 2 · Search */
  .mg-search_sec { margin-top: -28px; position: relative; z-index: 2; }
  .mg-search_card { background: var(--card); border: 1px solid var(--line); border-top: 4px solid var(--pdh-orange); box-shadow: var(--shadow); padding: 20px; display: grid; gap: 16px; }
  @media (min-width: 900px) { .mg-search_card { grid-template-columns: 1fr 1.4fr; align-items: center; padding: 28px; } .mg-cats_row { grid-column: 1 / -1; } }
  .mg-search_h { font-size: clamp(1.3rem, 1rem + 1.2vw, 1.9rem); margin: 0; }
  .mg-search_in { display: flex; align-items: center; gap: 10px; border: 2px solid var(--line); padding: 0 8px 0 14px; min-height: 56px; }
  .mg-search_in:focus-within { border-color: var(--pdh-teal); }
  .mg-search_in svg { width: 20px; height: 20px; color: var(--pdh-teal-text); flex: none; }
  .mg-search_in input { border: none; background: transparent; font: inherit; width: 100%; min-height: 48px; outline: none; color: inherit; }
  .mg-search_in .btn { flex: none; }
  .mg-cats_row { display: flex; flex-wrap: wrap; gap: 0 20px; }
  .mg-cats_row a { position: relative; display: inline-flex; align-items: center; min-height: var(--tap); padding: 10px 0; text-decoration: none; color: inherit; font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; flex: 1 1 auto; }
  .mg-cats_border { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--pdh-orange); transform-origin: left; transition: transform 0.3s var(--ease); }
  .mg-cats_row a:hover .mg-cats_border { transform: scaleY(3); }

  /* 3 + 4 · Grid */
  .mg-grid { padding: 8vh 0 0; }
  .mg-grid_in { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 900px) { .mg-grid_in { grid-template-columns: 1fr 3fr; gap: 48px; } }
