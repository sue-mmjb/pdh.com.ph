---
// Prototype-only bar to switch between the three design directions.
// Choosing an option also stores it so inner pages pick up the same theme.
interface Props { current: 'a' | 'b' | 'c'; }
const { current } = Astro.props;
const options = [
  { key: 'a', href: '/', label: 'Option A · PDH Brand', swatch: '#00a3a5' },
  { key: 'b', href: '/option-b/', label: 'Option B · Warm Care', swatch: '#c2552b' },
  { key: 'c', href: '/option-c/', label: 'Option C · Calm Platform', swatch: '#111513' },
];
---
<div class="optionbar" role="region" aria-label="Prototype design options">
  <div class="container">
    <span class="label">Prototype</span>
    {options.map((o) => (
      <a href={o.href} data-theme-pick={o.key} aria-current={o.key === current ? 'true' : undefined}>
        <span class="swatch" style={`background:${o.swatch}`} aria-hidden="true"></span>
        <span class="visually-hidden">{o.label.replace(' · ', ': ')}</span>
        <span aria-hidden="true">{o.key.toUpperCase()}</span>
      </a>
    ))}
    <span class="spacer"></span>
    <span class="hint">Same content, three design directions. Inner pages follow the option you pick.</span>
  </div>
</div>
<script is:inline>
  // First-party, prototype-only: remember the chosen option for inner pages.
  document.querySelectorAll('[data-theme-pick]').forEach(function (a) {
    a.addEventListener('click', function () {
      try { localStorage.setItem('pdh-theme', a.getAttribute('data-theme-pick')); } catch (e) {}
    });
  });
</script>
